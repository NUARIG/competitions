%tr{id: "user-#{user.id}", class: 'user'}
  %td
    = link_to sortable_full_name(user), edit_user_path(user)
  %td
    = user.email
  %td.small
    = user.saml_user? ? 'SAML User' : 'Registered User'
  %td.small
    = time_tag(user.created_at, date_time_date_only(user.created_at))
  %td.small
    = time_tag(user.current_sign_in_at, time_ago_in_words(user.current_sign_in_at)) if user.current_sign_in_at.present?
  %td.small
    - grant_permissions = kept_grant_permissions(user)
    - if grant_permissions.any?
      %ul.no-bullet
        - grant_permissions.each do |grant_permission|
          %li
            = link_to grant_permission.grant.name, grant_path(grant_permission.grant)
            = "(#{grant_permission.role.capitalize})"
  %td.small
    = link_to 'Edit', edit_user_path(user)
